    - A[2] + NET A[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -2000 ) ( 140 2000 )
        + PLACED ( 103270 198000 ) N ;
    - A[3] + NET A[3] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -2000 ) ( 140 2000 )
        + PLACED ( 96830 198000 ) N ;
    - Y[0] + NET Y[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -2000 ) ( 140 2000 )
        + PLACED ( 106490 198000 ) N ;
    - Y[1] + NET Y[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -2000 ) ( 140 2000 )
        + PLACED ( 109710 198000 ) N ;
    - Y[2] + NET Y[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -2000 ) ( 140 2000 )
        + PLACED ( 90390 198000 ) N ;
    - Y[3] + NET Y[3] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -2000 ) ( 140 2000 )
        + PLACED ( 93610 198000 ) N ;
END PINS
NETS 11 ;
    - A[0] ( PIN A[0] ) ( _9_ A ) ( _5_ A2 ) ( _4_ B ) ( _3_ B ) + USE SIGNAL ;
    - A[1] ( PIN A[1] ) ( _5_ A1 ) ( _4_ A ) ( _3_ A ) + USE SIGNAL ;
    - A[2] ( PIN A[2] ) ( _5_ B1 ) ( _4_ C ) + USE SIGNAL ;
    - A[3] ( PIN A[3] ) ( _8_ A ) + USE SIGNAL ;
    - Y[0] ( PIN Y[0] ) ( _9_ X ) + USE SIGNAL ;
    - Y[1] ( PIN Y[1] ) ( _3_ X ) + USE SIGNAL ;
    - Y[2] ( PIN Y[2] ) ( _7_ X ) + USE SIGNAL ;
    - Y[3] ( PIN Y[3] ) ( _8_ X ) + USE SIGNAL ;
    - _0_ ( _6_ B ) ( _5_ Y ) + USE SIGNAL ;
    - _1_ ( _7_ A ) ( _6_ X ) + USE SIGNAL ;
    - _2_ ( _8_ B ) ( _6_ A ) ( _4_ X ) + USE SIGNAL ;
END NETS
END DESIGN
