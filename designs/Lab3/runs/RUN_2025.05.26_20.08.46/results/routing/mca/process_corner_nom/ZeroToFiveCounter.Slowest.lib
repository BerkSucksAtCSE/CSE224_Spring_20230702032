library (ZeroToFiveCounter) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00551,  0.01830,  0.06076,  0.20175,  0.66987");
  }
  type ("count") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("ZeroToFiveCounter") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0098;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.18602");
	}
	cell_fall(scalar) {
          values("0.27884");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.27061");
	}
	cell_fall(scalar) {
          values("0.27884");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0035;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.75718");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("-0.54330");
	}
      }
    }
    bus("count") {
      bus_type : count;
      direction : output;
      capacitance : 0.0000;
    pin("count[3]") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.33701,1.34726,1.37402,1.44631,1.67174,2.41186,4.87818");
	}
	rise_transition(template_1) {
          values("0.03064,0.03943,0.06673,0.15761,0.47292,1.52760,5.00175");
	}
	cell_fall(template_1) {
          values("1.46977,1.47968,1.50373,1.55736,1.69331,2.11470,3.50795");
	}
	fall_transition(template_1) {
          values("0.03262,0.03940,0.05710,0.10707,0.27044,0.84134,2.74490");
	}
      }
    }
    pin("count[2]") {
      direction : output;
      capacitance : 0.0012;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.44536,1.45439,1.47965,1.54596,1.74661,2.45405,5.00815");
	}
	rise_transition(template_1) {
          values("0.03934,0.04590,0.06701,0.13830,0.40699,1.40349,4.99811");
	}
	cell_fall(template_1) {
          values("1.52415,1.53145,1.55366,1.60965,1.76604,2.30190,4.23208");
	}
	fall_transition(template_1) {
          values("0.03443,0.03977,0.05702,0.10978,0.30114,1.02123,3.64593");
	}
      }
    }
    pin("count[1]") {
      direction : output;
      capacitance : 0.0015;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.48988,1.50013,1.52719,1.59959,1.82534,2.56688,5.02117");
	}
	rise_transition(template_1) {
          values("0.03191,0.04072,0.06765,0.15800,0.47308,1.52762,5.00410");
	}
	cell_fall(template_1) {
          values("1.58742,1.59736,1.62137,1.67515,1.81115,2.23285,3.62714");
	}
	fall_transition(template_1) {
          values("0.03270,0.03936,0.05714,0.10717,0.27059,0.84153,2.74653");
	}
      }
    }
    pin("count[0]") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.43469,1.44486,1.47163,1.54390,1.76946,2.51017,4.97153");
	}
	rise_transition(template_1) {
          values("0.03079,0.03961,0.06682,0.15763,0.47301,1.52775,5.00243");
	}
	cell_fall(template_1) {
          values("1.58284,1.59276,1.61680,1.67049,1.80646,2.22796,3.62159");
	}
	fall_transition(template_1) {
          values("0.03265,0.03938,0.05711,0.10711,0.27050,0.84141,2.74550");
	}
      }
    }
    }
  }

}
