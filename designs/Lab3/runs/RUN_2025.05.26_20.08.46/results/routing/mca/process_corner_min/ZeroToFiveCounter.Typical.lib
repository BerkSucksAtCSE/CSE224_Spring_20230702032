library (ZeroToFiveCounter) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00146,  0.00429,  0.01257,  0.03681,  0.10783,  0.31587");
  }
  type ("count") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("ZeroToFiveCounter") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0096;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.18491");
	}
	cell_fall(scalar) {
          values("0.27784");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.26918");
	}
	cell_fall(scalar) {
          values("0.27784");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0035;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.38203");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("-0.28086");
	}
      }
    }
    bus("count") {
      bus_type : count;
      direction : output;
      capacitance : 0.0000;
    pin("count[3]") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.33167,1.33668,1.34871,1.37812,1.45863,1.69145,2.38129");
	}
	rise_transition(template_1) {
          values("0.01767,0.02204,0.03441,0.07142,0.18464,0.52107,1.50769");
	}
	cell_fall(template_1) {
          values("1.46510,1.46998,1.48025,1.50133,1.54666,1.66279,1.99724");
	}
	fall_transition(template_1) {
          values("0.01781,0.02058,0.02791,0.04571,0.09385,0.24217,0.69516");
	}
      }
    }
    pin("count[2]") {
      direction : output;
      capacitance : 0.0011;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.43943,1.44372,1.45494,1.48232,1.55535,1.77880,2.48711");
	}
	rise_transition(template_1) {
          values("0.02224,0.02561,0.03531,0.06474,0.16192,0.48205,1.50517");
	}
	cell_fall(template_1) {
          values("1.51859,1.52252,1.53273,1.55585,1.60992,1.76231,2.24253");
	}
	fall_transition(template_1) {
          values("0.02072,0.02330,0.03049,0.04989,0.10900,0.30671,0.94750");
	}
      }
    }
    pin("count[1]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.48362,1.48885,1.50121,1.53081,1.61120,1.84371,2.53694");
	}
	rise_transition(template_1) {
          values("0.01941,0.02367,0.03573,0.07210,0.18501,0.52151,1.50761");
	}
	cell_fall(template_1) {
          values("1.58290,1.58759,1.59784,1.61893,1.66435,1.78052,2.11540");
	}
	fall_transition(template_1) {
          values("0.01777,0.02068,0.02792,0.04567,0.09385,0.24228,0.69706");
	}
      }
    }
    pin("count[0]") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.42683,1.43185,1.44388,1.47327,1.55375,1.78627,2.47895");
	}
	rise_transition(template_1) {
          values("0.01786,0.02222,0.03454,0.07147,0.18478,0.52112,1.50789");
	}
	cell_fall(template_1) {
          values("1.57588,1.58071,1.59097,1.61206,1.65741,1.77355,2.10813");
	}
	fall_transition(template_1) {
          values("0.01780,0.02061,0.02791,0.04570,0.09385,0.24220,0.69572");
	}
      }
    }
    }
  }

}
