library (ZeroToFiveCounter) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00153,  0.00471,  0.01445,  0.04434,  0.13605,  0.41749");
  }
  type ("count") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("ZeroToFiveCounter") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0097;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.18491");
	}
	cell_fall(scalar) {
          values("0.27784");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.26918");
	}
	cell_fall(scalar) {
          values("0.27784");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0035;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.24408");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("-0.17962");
	}
      }
    }
    bus("count") {
      bus_type : count;
      direction : output;
      capacitance : 0.0000;
    pin("count[3]") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.33210,1.33583,1.34522,1.37013,1.44377,1.67031,2.36242");
	}
	rise_transition(template_1) {
          values("0.01251,0.01592,0.02618,0.05951,0.16628,0.49678,1.51009");
	}
	cell_fall(template_1) {
          values("1.46559,1.46895,1.47693,1.49376,1.53201,1.63681,1.95613");
	}
	fall_transition(template_1) {
          values("0.01268,0.01509,0.02084,0.03523,0.07666,0.21250,0.64046");
	}
      }
    }
    pin("count[2]") {
      direction : output;
      capacitance : 0.0011;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.44005,1.44339,1.45216,1.47453,1.54002,1.75473,2.46568");
	}
	rise_transition(template_1) {
          values("0.01672,0.01913,0.02675,0.05244,0.14438,0.45862,1.50338");
	}
	cell_fall(template_1) {
          values("1.51917,1.52220,1.53017,1.54885,1.59443,1.72983,2.17708");
	}
	fall_transition(template_1) {
          values("0.01542,0.01766,0.02328,0.03905,0.08873,0.26584,0.86373");
	}
      }
    }
    pin("count[1]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.48480,1.48897,1.49889,1.52403,1.59743,1.82363,2.51219");
	}
	rise_transition(template_1) {
          values("0.01513,0.01842,0.02796,0.06014,0.16604,0.49712,1.51036");
	}
	cell_fall(template_1) {
          values("1.58426,1.58763,1.59562,1.61249,1.65073,1.75554,2.07540");
	}
	fall_transition(template_1) {
          values("0.01297,0.01536,0.02108,0.03535,0.07669,0.21226,0.64248");
	}
      }
    }
    pin("count[0]") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.42692,1.43073,1.44022,1.46517,1.53876,1.76525,2.45670");
	}
	rise_transition(template_1) {
          values("0.01299,0.01638,0.02651,0.05963,0.16624,0.49684,1.51014");
	}
	cell_fall(template_1) {
          values("1.57599,1.57934,1.58732,1.60416,1.64243,1.74722,2.06684");
	}
	fall_transition(template_1) {
          values("0.01267,0.01510,0.02080,0.03522,0.07665,0.21238,0.64312");
	}
      }
    }
    }
  }

}
