library (ZeroToFiveCounter) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00551,  0.01830,  0.06076,  0.20175,  0.66987");
  }
  type ("count") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("ZeroToFiveCounter") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0096;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.18491");
	}
	cell_fall(scalar) {
          values("0.27784");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.26918");
	}
	cell_fall(scalar) {
          values("0.27784");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.75840");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("-0.54577");
	}
      }
    }
    bus("count") {
      bus_type : count;
      direction : output;
      capacitance : 0.0000;
    pin("count[3]") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.33068,1.34093,1.36770,1.43998,1.66540,2.40547,4.87221");
	}
	rise_transition(template_1) {
          values("0.03063,0.03942,0.06672,0.15761,0.47292,1.52759,5.00169");
	}
	cell_fall(template_1) {
          values("1.46415,1.47406,1.49811,1.55174,1.68769,2.10907,3.50229");
	}
	fall_transition(template_1) {
          values("0.03262,0.03940,0.05710,0.10707,0.27044,0.84133,2.74486");
	}
      }
    }
    pin("count[2]") {
      direction : output;
      capacitance : 0.0011;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.43771,1.44674,1.47198,1.53831,1.73896,2.44641,5.00052");
	}
	rise_transition(template_1) {
          values("0.03933,0.04590,0.06702,0.13829,0.40700,1.40340,4.99790");
	}
	cell_fall(template_1) {
          values("1.51743,1.52475,1.54696,1.60295,1.75935,2.29521,4.22514");
	}
	fall_transition(template_1) {
          values("0.03443,0.03977,0.05701,0.10977,0.30114,1.02121,3.64567");
	}
      }
    }
    pin("count[1]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.48074,1.49096,1.51796,1.59033,1.81608,2.55765,5.01179");
	}
	rise_transition(template_1) {
          values("0.03174,0.04056,0.06751,0.15794,0.47309,1.52769,5.00398");
	}
	cell_fall(template_1) {
          values("1.57975,1.58969,1.61369,1.66747,1.80347,2.22515,3.61938");
	}
	fall_transition(template_1) {
          values("0.03270,0.03936,0.05713,0.10716,0.27058,0.84152,2.74644");
	}
      }
    }
    pin("count[0]") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.42661,1.43680,1.46356,1.53583,1.76138,2.50202,4.96400");
	}
	rise_transition(template_1) {
          values("0.03077,0.03959,0.06681,0.15763,0.47300,1.52773,5.00234");
	}
	cell_fall(template_1) {
          values("1.57567,1.58559,1.60962,1.66331,1.79927,2.22076,3.61435");
	}
	fall_transition(template_1) {
          values("0.03265,0.03939,0.05711,0.10710,0.27049,0.84140,2.74543");
	}
      }
    }
    }
  }

}
