library (ZeroToFiveCounter) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00551,  0.01830,  0.06076,  0.20175,  0.66987");
  }
  type ("count") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("ZeroToFiveCounter") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0099;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.18768");
	}
	cell_fall(scalar) {
          values("0.28034");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.27264");
	}
	cell_fall(scalar) {
          values("0.28034");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0037;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.75648");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("-0.54116");
	}
      }
    }
    bus("count") {
      bus_type : count;
      direction : output;
      capacitance : 0.0000;
    pin("count[3]") {
      direction : output;
      capacitance : 0.0010;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.34352,1.35376,1.38053,1.45281,1.67825,2.41842,4.88439");
	}
	rise_transition(template_1) {
          values("0.03065,0.03944,0.06674,0.15761,0.47293,1.52761,5.00180");
	}
	cell_fall(template_1) {
          values("1.47570,1.48561,1.50966,1.56330,1.69925,2.12064,3.51392");
	}
	fall_transition(template_1) {
          values("0.03262,0.03940,0.05710,0.10708,0.27045,0.84134,2.74494");
	}
      }
    }
    pin("count[2]") {
      direction : output;
      capacitance : 0.0012;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.45387,1.46290,1.48816,1.55446,1.75511,2.46255,5.01665");
	}
	rise_transition(template_1) {
          values("0.03934,0.04590,0.06700,0.13830,0.40698,1.40357,4.99832");
	}
	cell_fall(template_1) {
          values("1.53174,1.53902,1.56123,1.61721,1.77361,2.30945,4.23989");
	}
	fall_transition(template_1) {
          values("0.03443,0.03977,0.05702,0.10978,0.30114,1.02125,3.64619");
	}
      }
    }
    pin("count[1]") {
      direction : output;
      capacitance : 0.0017;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.50025,1.51055,1.53767,1.61010,1.83585,2.57737,5.03181");
	}
	rise_transition(template_1) {
          values("0.03209,0.04089,0.06779,0.15807,0.47306,1.52755,5.00422");
	}
	cell_fall(template_1) {
          values("1.59628,1.60622,1.63022,1.68402,1.82002,2.24173,3.63608");
	}
	fall_transition(template_1) {
          values("0.03271,0.03936,0.05714,0.10717,0.27060,0.84154,2.74662");
	}
      }
    }
    pin("count[0]") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.44281,1.45298,1.47975,1.55202,1.77759,2.51836,4.97928");
	}
	rise_transition(template_1) {
          values("0.03081,0.03963,0.06683,0.15763,0.47301,1.52776,5.00248");
	}
	cell_fall(template_1) {
          values("1.59070,1.60062,1.62466,1.67835,1.81432,2.23584,3.62952");
	}
	fall_transition(template_1) {
          values("0.03265,0.03938,0.05711,0.10711,0.27051,0.84142,2.74557");
	}
      }
    }
    }
  }

}
