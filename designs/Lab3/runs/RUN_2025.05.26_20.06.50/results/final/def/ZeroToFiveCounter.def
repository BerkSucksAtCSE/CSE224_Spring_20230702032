    - count[0] ( PIN count[0] ) ( _26_ Q ) ( _18_ A2 ) ( _17_ B ) ( _16_ B ) ( _14_ A_N ) ( _13_ B ) + USE SIGNAL ;
    - count[1] ( PIN count[1] ) ( _27_ Q ) ( _18_ A1 ) ( _17_ A ) ( _16_ A ) ( _13_ A ) + USE SIGNAL ;
    - count[2] ( PIN count[2] ) ( _28_ Q ) ( _18_ B1 ) ( _17_ C ) ( _13_ D_N ) + USE SIGNAL ;
    - count[3] ( PIN count[3] ) ( _29_ Q ) ( _21_ A ) ( _13_ C ) + USE SIGNAL ;
    - rst ( PIN rst ) ( _25_ A ) ( _24_ A ) ( _23_ A ) ( _22_ A ) + USE SIGNAL ;
END NETS
END DESIGN
